#!/usr/bin/env python3
"""Switch the shared CLI theme without changing unrelated app settings."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[3]
DATA = ROOT / "theme/.config/dotfiles-theme"
THEMES = {
    "rose-pine": "Rose Pine",
    "rose-pine-moon": "Rose Pine Moon",
    "catppuccin-mocha": "Catppuccin Mocha",
    "vesper": "Vesper",
}


def replace(text, pattern, replacement):
    result, count = re.subn(pattern, lambda _: replacement, text, flags=re.MULTILINE)
    if count != 1:
        raise ValueError(f"expected exactly one theme setting matching {pattern!r}, found {count}")
    return result


def render(root, name):
    """Prepare every change before writing anything."""
    data = root / "theme/.config/dotfiles-theme"
    source = (data / "palettes" / name).read_text()
    values = dict(re.findall(r"^([a-z-]+) = (#[0-9a-fA-F]{6})$", source, re.MULTILINE))
    ansi = dict(re.findall(r"^palette = (\d+)=(#[0-9a-fA-F]{6})$", source, re.MULTILINE))
    p = {
        "bg": values["background"], "fg": values["foreground"],
        "surface": ansi["0"], "muted": ansi["8"],
        "accent": ansi["5"], "secondary": ansi["6"],
        "red": ansi["1"], "green": ansi["2"], "yellow": ansi["3"], "blue": ansi["4"],
        "selection": values["selection-background"],
    }
    outputs = {}

    def update(path, pattern, replacement):
        outputs[root / path] = replace((root / path).read_text(), pattern, replacement)

    update("ghostty/ghostty/config.ghostty", r"^theme = .*$", f"theme = {THEMES[name]}")
    terminal_palette = "# Generated by theme.\n" + source
    terminal_palette += "".join(f"palette = {index + 8}={ansi[str(index)]}\n" for index in range(1, 8))
    outputs[root / "ghostty/ghostty/theme.ghostty"] = terminal_palette

    # JSON values are valid YAML, so no YAML dependency is needed for this block.
    lazygit = {
        "activeBorderColor": [p["accent"], "bold"], "inactiveBorderColor": [p["muted"]],
        "searchingActiveBorderColor": [p["yellow"], "bold"], "optionsTextColor": [p["blue"]],
        "selectedLineBgColor": [p["surface"]], "inactiveViewSelectedLineBgColor": [p["selection"]],
        "cherryPickedCommitBgColor": [p["selection"]], "cherryPickedCommitFgColor": [p["accent"]],
        "unstagedChangesColor": [p["red"]], "defaultFgColor": [p["fg"]],
    }
    block = "  theme:\n" + "".join(f"    {key}: {json.dumps(value)}\n" for key, value in lazygit.items())
    update("lazygit/lazygit/config.yml", r"^  theme:\n(?:    .*\n)*", block)

    styles = {
        "status-style": f"bg=default,fg={p['fg']}",
        "window-status-style": f"fg={p['muted']},bg=default",
        "window-status-current-style": f"fg={p['accent']},bg=default,bold",
        "window-status-activity-style": f"fg={p['secondary']},bg=default",
        "pane-border-style": f"fg={p['muted']},bg=default",
        "pane-active-border-style": f"fg={p['accent']},bg=default",
        "message-style": f"fg={p['fg']},bg={p['surface']}",
        "message-command-style": f"fg={p['fg']},bg={p['surface']}",
        "popup-style": f"fg={p['fg']},bg={p['surface']}",
        "popup-border-style": f"fg={p['accent']}",
        "mode-style": f"fg={p['bg']},bg={p['accent']}",
    }
    tmux = f"# Generated by theme {name}; edit the shared palette, not this file.\n"
    for key, value in {"@theme-secondary": p["secondary"], "@theme-muted": p["muted"],
                       "@floax-border-color": p["accent"], "@floax-text-color": p["fg"], **styles}.items():
        tmux += f"set -g {key} '{value}'\n"
    outputs[root / "tmux/tmux/theme.conf"] = tmux

    prompt = {"teal": p["secondary"], "peach": p["yellow"], "mauve": p["accent"],
              "green": p["green"], "sapphire": p["blue"], "yellow": p["yellow"],
              "flamingo": p["secondary"], "blue": p["blue"], "red": p["red"], "overlay0": p["muted"]}
    starship = (root / "starship/starship.toml").read_text()
    starship = replace(starship, r'^palette = .*$', 'palette = "shared"')
    palette = "[palettes.shared]\n" + "".join(f"{key} = '{value}'\n" for key, value in prompt.items())
    outputs[root / "starship/starship.toml"] = replace(
        starship, r"^\[palettes\.(?:catppuccin_mocha|shared)\]\n(?:[^\[][^\n]*\n|\n)*", palette)

    # Bat's ANSI theme follows the terminal palette instead of forcing truecolor.
    update("bat/bat/config", r"^--theme=.*$", '--theme="ansi"')
    update("btop/btop/btop.conf", r'^color_theme = .*$', 'color_theme = "shared"')
    delta = "# Generated by theme.\n[delta \"shared\"]\n\tsyntax-theme = ansi\n"
    for key, value in {"minus-style": f"{p['red']} {p['bg']}", "plus-style": f"{p['green']} {p['bg']}",
                       "minus-emph-style": f"{p['red']} {p['surface']}",
                       "plus-emph-style": f"{p['green']} {p['surface']}",
                       "line-numbers-zero-style": p["muted"]}.items():
        delta += f"\t{key} = {json.dumps(value)}\n"
    outputs[root / "git/git/themes/shared.gitconfig"] = delta

    btop = {"main_bg": "bg", "main_fg": "fg", "title": "accent", "hi_fg": "blue",
            "selected_bg": "selection", "selected_fg": "fg", "inactive_fg": "muted",
            "graph_text": "fg", "meter_bg": "surface", "proc_misc": "secondary",
            "cpu_box": "blue", "mem_box": "green", "net_box": "accent", "proc_box": "secondary",
            "div_line": "muted", "temp_start": "yellow", "temp_mid": "accent", "temp_end": "red"}
    for metric, colors in {"cpu": ("blue", "secondary", "green"), "free": ("secondary", "secondary", "green"),
                           "cached": ("accent", "accent", "secondary"), "available": ("fg", "secondary", "green"),
                           "used": ("yellow", "accent", "red"), "download": ("blue", "secondary", "accent"),
                           "upload": ("accent", "secondary", "blue"), "process": ("blue", "secondary", "green")}.items():
        btop.update({f"{metric}_{position}": color for position, color in zip(("start", "mid", "end"), colors)})
    outputs[root / "btop/btop/themes/shared.theme"] = "# Generated by theme.\n" + "".join(
        f'theme[{key}]="{p[color]}"\n' for key, color in btop.items())

    yazi = f'''# Generated by theme {name}.
[mgr]
cwd = {{ fg = "{p['secondary']}" }}
border_style = {{ fg = "{p['muted']}" }}
find_keyword = {{ fg = "{p['yellow']}", bold = true }}
marker_copied = {{ fg = "{p['green']}", bg = "{p['green']}" }}
marker_cut = {{ fg = "{p['red']}", bg = "{p['red']}" }}
marker_selected = {{ fg = "{p['accent']}", bg = "{p['accent']}" }}
[tabs]
active = {{ fg = "{p['bg']}", bg = "{p['accent']}", bold = true }}
inactive = {{ fg = "{p['fg']}", bg = "{p['surface']}" }}
[mode]
normal_main = {{ fg = "{p['bg']}", bg = "{p['accent']}", bold = true }}
normal_alt = {{ fg = "{p['fg']}", bg = "{p['surface']}" }}
select_main = {{ fg = "{p['bg']}", bg = "{p['secondary']}", bold = true }}
select_alt = {{ fg = "{p['fg']}", bg = "{p['surface']}" }}
unset_main = {{ fg = "{p['bg']}", bg = "{p['red']}", bold = true }}
unset_alt = {{ fg = "{p['fg']}", bg = "{p['surface']}" }}
[pick]
border = {{ fg = "{p['accent']}" }}
active = {{ fg = "{p['secondary']}", bold = true }}
[input]
border = {{ fg = "{p['accent']}" }}
[which]
border = {{ fg = "{p['accent']}" }}
cand = {{ fg = "{p['secondary']}" }}
desc = {{ fg = "{p['fg']}" }}
'''
    outputs[root / "yazi/yazi/theme.toml"] = yazi
    outputs[data / "current"] = name + "\n"
    return outputs


def write_outputs(outputs):
    for path, text in outputs.items():
        path = path.resolve()  # Preserve Stow symlinks if a target is itself linked.
        if path.exists() and path.read_text() == text:
            continue
        path.parent.mkdir(parents=True, exist_ok=True)
        mode = path.stat().st_mode & 0o777 if path.exists() else 0o644
        fd, temporary = tempfile.mkstemp(dir=path.parent)
        try:
            with os.fdopen(fd, "w") as stream:
                stream.write(text)
            os.chmod(temporary, mode)
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)


def refresh_terminal(source):
    """Update attached terminals through their client TTY, not a tmux pane."""
    values = dict(re.findall(r"^([a-z-]+) = (#[0-9a-fA-F]{6})$", source, re.MULTILINE))
    payload = f"\033]10;{values['foreground']}\a\033]11;{values['background']}\a"
    colors = re.findall(r"^palette = (\d+)=(#[0-9a-fA-F]{6})$", source, re.MULTILINE)
    payload += "".join(f"\033]4;{index};{color}\a" for index, color in colors)
    refreshed = False
    if os.environ.get("TMUX") and shutil.which("tmux"):
        clients = subprocess.run(["tmux", "list-clients", "-F", "#{client_tty}"], capture_output=True, text=True)
        for tty in set(clients.stdout.splitlines()):
            if not tty.startswith("/dev/"):
                continue
            try:
                with open(tty, "wb", buffering=0) as stream:
                    if os.isatty(stream.fileno()) and os.fstat(stream.fileno()).st_uid == os.getuid():
                        stream.write(payload.encode())
                        refreshed = True
            except OSError as error:
                print(f"theme: could not refresh terminal {tty}: {error}", file=sys.stderr)
    elif sys.stdout.isatty():
        sys.stdout.write(payload)
        refreshed = True
    return refreshed


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", choices=THEMES)
    args = parser.parse_args()
    if args.name is None:
        print((DATA / "current").read_text().strip())
        print("Available: " + ", ".join(THEMES))
        return
    try:
        outputs = render(ROOT, args.name)
        write_outputs(outputs)
    except (OSError, ValueError, KeyError) as error:
        parser.exit(1, f"theme: {error}\n")
    print(f"Theme: {args.name}")
    refreshed = refresh_terminal(outputs[ROOT / "ghostty/ghostty/theme.ghostty"])
    if shutil.which("tmux"):
        result = subprocess.run(["tmux", "source-file", str(ROOT / "tmux/tmux/theme.conf")],
                                capture_output=True, text=True)
        if result.returncode:
            print("tmux: saved; no running server was refreshed.")
    print("Neovim refreshes on focus; reopen LazyGit, btop, and Yazi.")
    print("Attached terminals refreshed." if refreshed else "Terminal palette saved.")
    print("Reload other Ghostty windows with Ctrl+Shift+,.")
    print("New prompts and bat use the selected palette. GUI/desktop themes are unchanged.")


if __name__ == "__main__":
    main()
