{
  "cava": {
    "framerate": 30,
    "bars": 6,
    "method": "pulse",
    "source": "auto",
    "stereo": true,
    "bar_delimiter": 0,
    "monstercat": false,
    "waves": false,
    "noise_reduction": 0.77,
    "input_delay": 2,
    "sleep_timer": 2,
    "hide_on_silence": true,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "tooltip": false,
  },
  "mpris": {
    "player": "spotify",
    "format": " <span size='11pt'>{dynamic}</span>",
    "format-paused": " <span size='11pt'>{dynamic}</span>",
    "dynamic-order": ["artist", "title"],
    "dynamic-importance-order": ["artist", "title"],
    "dynamic-separator": " — ",
    "artist-len": 12,
    "title-len": 18,
    "dynamic-len": 33,
    "max-length": 36,
    "tooltip-format": "  {title}\n󰠃  {artist}\n󰀥  {album}\n{status_icon}  {status}",
    "status-icons": {
      "playing": "",
      "paused": "",
      "stopped": "",
    },
    "on-click": "~/.config/waybar/scripts/spotify-focus",
  },
}
