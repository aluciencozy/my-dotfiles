{
  "id": "root",
  "type": "row",
  "padding": 12,
  "gap": 12,
  "divider": {
    "width": 1,
    "color": "#30375000"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "#00000000",
      "padding": 0,
      "gap": 12,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "radius": 0,
          "border": {
            "width": 1,
            "color": "border"
          },
          "window_drag": true,
          "content": {
            "mod": "alex-islands-chrome"
          }
        },
        {
          "id": "sidebar-lists-container",
          "type": "column",
          "size": {
            "weight": 1
          },
          "min": 90,
          "gap": 0,
          "children": [
            {
              "id": "sidebar-lists",
              "type": "block",
              "radius": 0,
              "border": {
                "width": 1,
                "color": "border"
              },
              "content": {
                "mod": "alex-sidebar"
              }
            },
            {
              "id": "port-observer",
              "type": "block",
              "size": { "px": 0 },
              "content": { "mod": "alex-ports" }
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "size": {
            "px": 34
          },
          "min": 34,
          "radius": 0,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "alex-usage"
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 97
          },
          "radius": 0,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "alex-sidebar",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "gap": 12,
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 42
          },
          "gap": 12,
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "radius": 0,
              "border": {
                "width": 1,
                "color": "border"
              },
              "window_drag": true,
              "content": {
                "mod": "alex-tabs"
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 12,
          "divider": {
            "width": 1,
            "color": "#30375000"
          },
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 0,
                  "lone": true,
                  "background": "#00000000",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "height": 30,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "skills",
                  "children": [
                    {
                      "id": "needs-me",
                      "type": "block",
                      "content": {
                        "mod": "alex-needs-me"
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "alex-islands-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "alex-islands-changes"
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "alex-issues"
                      }
                    },
                    {
                      "id": "skills",
                      "type": "block",
                      "content": {
                        "mod": "alex-skills"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "radius": 0,
          "border": {
            "width": 1,
            "color": "border"
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ],
  "background": "canvas",
  "theme": "alex-islands",
  "colors": {
    "canvas": "#00000000",
    "chrome": "#1e223599",
    "background": "#22263b99",
    "surface": "#252a4099",
    "popover": "#202438f5",
    "raised": "#353e5ddd",
    "hover": "#2b314bdd",
    "selected": "#303c69e8",
    "border": "#414a6cdd",
    "input": "#414a6cf2",
    "foreground": "#c8d3f5",
    "muted": "#9aa5ce",
    "dim": "#727fae",
    "accent": "#84a8ff",
    "accent_foreground": "#191c2c",
    "solid": "#84a8ff",
    "solid_foreground": "#191c2c",
    "working": "#e0af68",
    "blocked": "#f7768e",
    "done": "#9ece6a",
    "idle": "#727fae",
    "unknown": "#454d6c"
  },
  "font": "JetBrainsMono Nerd Font Mono",
  "font_size": 16,
  "ui_font": "JetBrainsMono Nerd Font Mono",
  "terminal_padding": [
    6,
    8
  ],
  "terminal_opacity": 0.6,
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/alex-islands.svg"
}
