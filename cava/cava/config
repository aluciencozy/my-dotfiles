[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
sleep_timer = 3

[input]
# pipewire-pulse provides this server on the current PipeWire setup.
method = pulse
source = auto

[output]
method = ncurses
channels = stereo

[color]
background = default
gradient = 1
gradient_color_1 = '#8bd5ca'
gradient_color_2 = '#91d7e3'
gradient_color_3 = '#7dc4e4'
gradient_color_4 = '#8aadf4'
gradient_color_5 = '#b7bdf8'
gradient_color_6 = '#c6a0f6'
gradient_color_7 = '#f5bde6'
gradient_color_8 = '#ed8796'

[smoothing]
noise_reduction = 0.77
